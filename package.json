{
  "name": "atelier-01",
  "private": true,
  "version": "1.0.0",
  "description": "Site premium fictício para o escritório de arquitetura e design de interiores ATELIER 01",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/lib/*.test.ts",
    "assets": "node scripts/generate-placeholders.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
