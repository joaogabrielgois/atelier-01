# Copie para .env.local (desenvolvimento) ou configure em Vercel > Settings > Environment Variables.

# URL pública do site, sem barra final. Usada em metadados e no sitemap.
VITE_SITE_URL=https://www.exemplo.com.br

# Endpoint que recebe o formulário de contato (POST JSON). Exemplos: Formspree, Web3Forms,
# ou uma função serverless sua. Se vazio, o formulário oferece envio por e-mail (mailto).
VITE_CONTACT_ENDPOINT=

# E-mail de contato exibido no site e usado como alternativa ao formulário.
VITE_CONTACT_EMAIL=contato@exemplo.com.br

# WhatsApp com DDI + DDD, somente números. Ex.: 5511999999999. Se vazio, o botão não aparece.
VITE_WHATSAPP_NUMBER=
